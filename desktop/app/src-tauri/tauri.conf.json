{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Monet Shot",
  "mainBinaryName": "monet-shot",
  "version": "0.2.0",
  "identifier": "com.connorhood.monetshot",
  "build": {
    "beforeDevCommand": "npm run wasm && npm run dev",
    "devUrl": "http://localhost:5183",
    "beforeBuildCommand": "npm run wasm && npm run build",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": null,
      "assetProtocol": { "enable": true, "scope": { "allow": ["**"], "requireLiteralLeadingDot": false } }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "deb", "nsis"],
    "category": "Video",
    "shortDescription": "A screen recorder that makes your recordings look good",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../../Resources/Backdrops/": "Backdrops/",
      "../../../Resources/Music/": "Music/"
    }
  }
}
